#!/bin/bash

if [ "$1" == "" ]; then
    echo "Usage: make_key key_name subject"
    exit 1
fi

AUTH=$(openssl version | grep -q "OpenSSL 3" && echo "-addext SubjectAlternativeName=email:copy" || echo "")

openssl genrsa -3 -out "$1".pem 2048

openssl req -new -x509 -key "$1".pem -out "$1".x509.pem -utf8 -days 10000 \
    -subj "$2" $AUTH

openssl pkcs8 -in "$1".pem -topk8 -outform DER -out "$1".pk8 -nocrypt
